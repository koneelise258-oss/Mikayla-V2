rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(
          /databases/ai-studio-android-mikayala-9f74e746-a740-4f00-85b2-7a4d380087a6/documents/couple_spaces/$(coupleId)
        ).data.memberUids;
    }

    // Avatars utilisateur : lecture par utilisateurs connectés, écriture uniquement par le propriétaire (<= 5 Mo)
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Médias privés du couple (photos, vocaux, vidéos, coffre, documents) : accès strict aux 2 partenaires (<= 50 Mo)
    match /messages-media/{coupleId}/{allPaths=**} {
      allow read: if isCoupleMember(coupleId);
      allow write: if isCoupleMember(coupleId) &&
        request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isCoupleMember(coupleId);
    }

    // Refuser tout le reste par défaut
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
