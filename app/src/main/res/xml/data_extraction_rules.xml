<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde cloud et transfert vers un nouvel appareil.
     Exclu : mikayala_push_prefs (secret d'installation et jetons FCM, propres à CET appareil). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mikayala_push_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mikayala_push_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
